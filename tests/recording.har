/icpplus/ruxitagentjs_ICANVfghqru_10343260715123811.js\" data-dtconfig=\"app=fc0be45c7c7075ff|cuc=ouei22vu|owasp=1|mel=100000|featureHash=ICANVfghqru|dpvc=1|md=mdcc1=bnavigator.userAgent|lastModification=1787548648315|tp=500,50,0|rdnt=1|uxrgce=1|srbbv=2|agentUri=/icpplus/ruxitagentjs_ICANVfghqru_10343260715123811.js|reportUrl=/icpplus/rb_38993f78-c97c-4ab5-8f9e-8df5e35f736d|rid=RID_807153635|rpid=132798083|domain=administracionelectronica.gob.es\"></script><link rel=\"shortcut icon\" href=\"/icpplus/resources/css/eSede/images/logo.ico\" />\r\n<link rel=\"stylesheet\" href=\"/icpplus/resources/css/font-awesome-4.7.0/css/font-awesome.min.css?v=V%207.50.2\">\r\n<link rel=\"stylesheet\" href=\"/icpplus/resources/css/eu-captcha/eu-captcha-style.css?v=V%207.50.2\">\r\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css\">\r\n<link href=\"/icpplus/resources/css/jquery-confirm.css\" type=\"text/css\" rel=\"stylesheet\"  />\r\n<link href=\"/icpplus/resources/css/morfos/grid-min.css?v=V%207.50.2\" type=\"text/css\" rel=\"stylesheet\"  />\r\n<link href=\"/icpplus/resources/css/morfos/styles-sede.css\" type=\"text/css\" rel=\"stylesheet\"  />\r\n\r\n<link href=\"/icpplus/resources/css/eSedeMPT/cssEsede_icp-6.50.1.css?v=7.50.2\" type=\"text/css\" rel=\"stylesheet\"  />\n<link href=\"/icpplus/resources/css/jquery-ui-6.50.1.css\" type=\"text/css\" rel=\"stylesheet\"/>\r\n<link href=\"/icpplus/resources/css/icp-7.29.css?v=V%207.50.2\" type=\"text/css\" rel=\"stylesheet\"/>\r\n\r\n<script src=\"/icpplus/resources/js/icp-7.37.min.js?v=V%207.50.2\"></script>\n\r\n<script src=\"/icpplus/resources/js/cookielawinfo.js?v=V%207.50.2\"></script>\r\n<script src=\"/icpplus/resources/js/jquery-3.5.1.min.js\"></script>\r\n<script src=\"/icpplus/resources/js/jquery-ui.js\"></script>\r\n<script src=\"/icpplus/resources/js/jquery-confirm.js\"></script>\r\n\r\n\r\n<script src=\"/icpplus/resources/js/morfos/modernizr.js\"></script>\r\n<script src=\"/icpplus/resources/js/morfos/datepicker.js\"></script>\r\n<script src=\"/icpplus/resources/js/morfos/morfos.js\"></script>\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\tvar ua = \"UA-33444577-1\";\r\n\tvar _gaq = _gaq || [];\r\n  \t_gaq.push(['_setAccount', ua]);\r\n  \t_gaq.push(['_trackPageview']);\r\n\r\n  \t(function() {\r\n  \t\tif(ua!='null' && ua!=''){\r\n\t    \tvar ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;\r\n\t    \tga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';\r\n\t    \tvar s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);\r\n  \t\t}\r\n  \t})(); \r\n</script>\r\n\r\n\r\n\r\n\r\n\r\n\r\n</head>\r\n\r\n\r\n<body class=\"sede \" scroll=\"yes\">\r\n\r\n\t<div id=\"container\" class=\"mf-container\">\r\n\t\r\n    <noscript>\r\n\t    <div id=\"noJS\" class=\"ac-msg__no-js\" role=\"alert\">\r\n\t        <p class=\"mf-paragraph-header\">\r\n\t            JavaScript desactivado        </p>\r\n\t        <p>\r\n\t            Es posible que JavaScript no esté activado en su navegador y es necesario para el funcionamiento de este\r\n\t                    sitio.            Por favor, actívelo para poder continuar y recargue la página.        </p>\r\n\t    </div>\r\n\t</noscript>\r\n\r\n\r\n\r\n\r\n\r\n\t<header id=\"header\" class=\"mf-header noprint\" role=\"banner\">\r\n\t\t<div class=\"mf-header--container\">\n        <div class=\"mf-header--logo\">\n            <p class=\"mf-logo\">\n                <span class=\"mf-logo--link\">\n                \t<img class=\"mf-logo--img\" src=\"data:image/png;base64,\" \n                \t\talt=\"Extranjería\" />                \t\n\t\t\t\t\t\n                </span>\n                \n            </p>\n        </div>\n        \n        <div id=\"topBar\" class=\"mf-topbar\">\n        \t<button class=\"mf-topbar-button\"><span>Opciones</span></button>          \n            <div class=\"mf-topbar-veil\"></div>\n            <div class=\"mf-topbar--container\">\n                <ul id=\"accMenu\" class=\"mf-accesibility-menu\">\n                    <li class=\"mf-accesibility-item\"><a id=\"accGotoContent\" class=\"mf-topbar--item\" href=\"#wrap\">Ir al contenido</a></li>\n                    <li class=\"mf-accesibility-item\"><a class=\"mf-topbar--item\" href=\"accesibilidad\" target=\"_blank\">Accesibilidad</a>\n                    </li>                    \n                </ul>                \n                \t\n            </div>\n        </div>\n        <div class=\"mf-header--content\">\n\n            <div class=\"mf-app-title--container\">\n                <h1 class=\"mf-app-title\">Sede electr&oacute;nica</h1>\n\t\t\t\t<p class=\"mf-app-subtitle\">Administraciones Públicas</p>\n            </div>\n\n            <div id=\"mainMenu\" class=\"mf-appmenu\">\n                <nav id=\"nav\" role=\"menubar\">\n                    <div class=\"mf-appmenu--title\">\n                        <button class=\"mf-appmenu--button\"><span>Men&amp;uacute; principal</span></button>\n                        <div class=\"mf-appmenu--veil\"></div>\n                    </div>\n\n                    <input type=\"hidden\" id=\"urlSede\" value=\"https://sede.administracionespublicas.gob.es/\"/>\n                    <ul class=\"mf-appmenu--menu\" role=\"navigation\">\n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\"><a href=\"https://sede.administracionespublicas.gob.es/\" onclick=\"goSalir($('#urlSede').val())\">INICIO</a></li>\n                        \n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\">\n                        \t<a href=\"https://sede.administracionespublicas.gob.es/procedimientos/\" onclick=\"goSalir($('#urlSede').val()+'procedimientos//')\"><span>PROCEDIMIENTOS</span></a>\n                        </li>\n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\">\n                        \t<a href=\"https://sede.administracionespublicas.gob.es/expedientes/\" onclick=\"goSalir($('#urlSede').val()+'expedientes/')\">MIS EXPEDIENTES</a></li>\n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\"><a\n                                href=\"https://sede.administracionespublicas.gob.es/mis-notificaciones/index\" onclick=\"goSalir($('#urlSede').val()+'mis-notificaciones/index')\">MIS NOTIFICACIONES</a></li>\n                         <li class=\"mf-appmenu--item mf-appmenu--item__L1\">\n                         \t<a href=\"https://sede.administracionespublicas.gob.es/pagina/index/directorio/ayuda_de_navegacion\"  onclick=\"goSalir($('#urlSede').val()+'pagina/index/directorio/ayuda_de_navegacion')\">Ayuda</a></li>\n\n\n                    </ul>\n\n                    \n                </nav>\n            </div>\n        </div>\n        \n\t\t<input type=\"hidden\" value=\"Vas a salir de la aplicación web de Cita Previa\n\n¿Estas seguro?\" id=\"litSalirSeguro\" />\n\t    <input type=\"hidden\" value=\"INTERNET CITA PREVIA\" id=\"litICP\" />\t    \n    </div>\r\n\t</header>\r\n\t<div id=\"wrap\" class=\"mf-wrapper\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\r\n\t<div class=\"mf-media\"><div class=\"mf-media--ext\">7.50.2</div></div>\r\n\r\n\t<input type=\"hidden\" name='alert_captcha' id='alert_captcha' value=\"Has introducido incorrectamente el código de la imagen\"/>\r\n    <input type=\"hidden\" name=\"lit_no_olvide_dato\" id=\"lit_no_olvide_dato\" value=\"No olvides introducir el dato:\" />\r\n    <input type=\"hidden\" name=\"lit_es_dato_obligatorio\" id=\"lit_es_dato_obligatorio\" value=\"Es un dato obligatorio\" />        \r\n    <input type=\"hidden\" name=\"alert_demasiado_corto\" id=\"alert_demasiado_corto\" value=\"Es demasiado corto.\" />\r\n    <input type=\"hidden\" name=\"lit_DebeComenzarPorLaLetra\" id=\"lit_DebeComenzarPorLaLetra\" value=\"Debe comenzar por la letra\" />\r\n    <input type=\"hidden\" name=\"lit_DebeAcabarPorUnaLetra\" id=\"lit_DebeAcabarPorUnaLetra\" value=\"Debe acabar por una letra\" />\r\n    <input type=\"hidden\" name=\"lit_Incorrecto\" id=\"lit_Incorrecto\" value=\"Incorrecto\" />\r\n    <input type=\"hidden\" name=\"lit_EsIncorrecto\" id=\"lit_EsIncorrecto\" value=\"Es incorrecto\" />\r\n    <input type=\"hidden\" name=\"lit_ElNIEIntroducidoEsIncorrectoPorFavorReviseloAntesDeContinuar\" id=\"lit_ElNIEIntroducidoEsIncorrectoPorFavorReviseloAntesDeContinuar\" value=\"El N.I.E. introducido es incorrecto, por favor revísalo antes de continuar\" />\r\n    <input type=\"hidden\" name=\"lit_ElFormatoDeLa0EsIncorrectoReviselo_formato\" id=\"lit_ElFormatoDeLa0EsIncorrectoReviselo_formato\" value=\"El formato de la {0} es incorrecto, revisalo.(dd/mm/aaaa)\" />\r\n    <input type=\"hidden\" name=\"lit_AVISO_CITA_PREVIA\" id=\"lit_AVISO_CITA_PREVIA\" value=\"AVISO CITA PREVIA\" />\r\n    <input type=\"hidden\" name=\"lit_PorFavorIntroduzcaLaFechaRequerida\" id=\"lit_PorFavorIntroduzcaLaFechaRequerida\" value=\"Por favor, introduce la fecha requerida\" />    \r\n    <input type=\"hidden\" name=\"lit_LaFechaIntroducidaEnElCampoDeFechaEsErronea\" id=\"lit_LaFechaIntroducidaEnElCampoDeFechaEsErronea\" value=\"La fecha introducida en el campo de fecha es errónea\" />\r\n    \r\n\t <script type=\"text/javascript\">\r\n      //<![CDATA[  \t  \r\n   \t  \r\n   \t  \r\n      jQuery(document).ready(function() {   \r\n    \t  var idioma = \"es\";\r\n    \t  if(idioma==null || idioma==''){\r\n    \t \tidioma='es';\r\n    \t  }\r\n\t\t  if( idioma!='en'){\r\n\t\t\tlet monthNamesShort = \"Ene,Feb,Mar,Abr,May,Jun,Jul,Ago,Sep,Oct,Nov,Dic\".split(',');\r\n\t\t\tlet dayNames = \"Domingo,Lunes,Martes,Mi\\u00E9rcoles,Jueves,Viernes,S\\u00E1bado\".split(',');\t\t\t\r\n\t  \t\t$.datepicker.regional[idioma] = {\r\n\t\t\t\t closeText: '\"Cerrar\"',\r\n\t\t\t\t prevText: '\"< Ant\"',\r\n\t\t\t\t nextText: '\"Sig >\"',\r\n\t\t\t\t currentText: '\"Hoy\"',\r\n\t\t\t\t monthNames: [ \"Enero\", \"Febrero\", \"Marzo\", \"Abril\", \"Mayo\", \"Junio\", \"Julio\", \"Agosto\", \"Septiembre\", \"Octubre\", \"Noviembre\", \"Diciembre\" ],\r\n\t\t\t\t monthNamesShort: monthNamesShort,\r\n\t\t\t\t monthStatus: '\"Ver otro mes\"', yearStatus: '\"Ver otro a\\u00F1o\"',\r\n\t\t\t\t dayNames: dayNames,\r\n\t\t\t\t dayNamesShort: \"Dom,Lun,Mar,Mi\\u00E9,Juv,Vie,S\\u00E1b\".split(','),\r\n\t\t\t\t dayNamesMin: \"Do,Lu,Ma,Mi,Ju,Vi,S\\u00E1\".split(','),\r\n\t\t\t\t weekHeader: 'Sm',\r\n\t\t\t\t dateFormat: 'dd/mm/yy',\r\n\t\t\t\t firstDay: 1,\r\n\t\t\t\t isRTL: false,\r\n\t\t\t\t showMonthAfterYear: false,\r\n\t\t\t\t yearSuffix: '',\r\n\t\t\t\t initStatus: '\"Selecciona la fecha\"'\r\n\t\t\t};\r\n\t\t  }\r\n    \t  $.datepicker.setDefaults($.datepicker.regional[idioma]);\r\n    \t  $.datepicker.setDefaults({\r\n    \t\t  showOn: \"button\",\r\n    \t\t  buttonImageOnly: true,\r\n    \t\t  buttonImage: \".\\\\static\\\\css\\\\morfos\\\\images\\\\calendario.gif\",\r\n    \t\t  dateFormat: 'dd/mm/yy'\r\n    \t  });\r\n\r\n      });      \r\n      //]]>\r\n\r\n      </script>\r\n      \r\n\t<main id=\"mainWindow\" class=\"ac-section mf-main\">\t\r\n    <div class=\"mf-layout--row\">\r\n    \r\n    <div class=\"mf-layout--main\">\r\n    <section class=\"mf-layout--main-content\">\r\n\t<div class=\"mf-window-header\">\r\n         \r\n        <div >\r\n            <h2 class=\"mf-window-header--title\">CITA PREVIA EXTRANJERÍA</h2>\r\n        </div> \t  \t\r\n   \t\t<p class=\"mf-app-subtitle\">POLICÍA-TOMA DE HUELLAS (EXPEDICIÓN DE TARJETA) INICIAL, RENOVACIÓN, DUPLICADO Y LEY 14/2013</p>\r\n\t</div>\r\n\t<div class=\"mf-main--content ac-custom-content\">\r\n\t<form action=\"acEntrada\" name=\"info\" method=\"post\"><input type=\"hidden\" name=\"0390be60-76b9-4a64-a23e-983444415eea\" value/><input type=\"hidden\" name=\"d72b307a-c9b1-4c5f-84a0-be64dbb119e9\" value=\"a17e82fd-e4a9-4d74-954c-6e7a77685196\"/>\r\n\t\r\n\t\r\n\t\t\r\n\t<div >\r\n\t\t<div class=\"mf-main--content show_code\">\r\n                <p><p><span style=\"color: red;\">IMPORTANTE:</span></p>\r\n<p><span style=\"color: red;\">Si va solicitar cita para la expedici&oacute;n de la TIE correspondiente a la Disposici&oacute;n Adicional 20&ordf; de la <strong>Regularizaci&oacute;n Extraordinaria</strong> (RD 316/2026, de 14 de abril), recuerde que, como parte de la documentaci&oacute;n requerida, debe aportar en la Unidad de Documentaci&oacute;n de Polic&iacute;a Nacional el <strong>justificante de desistimiento</strong> de la solicitud a la Protecci&oacute;n Internacional, o del posible recurso a su denegaci&oacute;n, en el caso de haberlo interpuesto.</span></p>\r\n<p>Puede obtener m&aacute;s informaci&oacute;n al respecto a trav&eacute;s de la p&aacute;gina oficial de la <a href=\"https://proteccion-asilo.interior.gob.es/es/presentacion-de-documentacion-por-sede-o-registro/pi-solicitud-de-desistimiento-o-renuncia/\" target=\"_blank\">Oficina de Asilo y Refugio</a>, desde donde tambi&eacute;n podr&aacute; descargar los formularios espec&iacute;ficos de desistimiento o la posibilidad de realizar el tr&aacute;mite directamente a trav&eacute;s de su sede electr&oacute;nica.</p>\r\n<p><strong>LA EXPEDICI&Oacute;N DE TARJETA DE IDENTIDAD DE EXTRANJERO (T.I.E.) S&Oacute;LO PODR&Aacute; SER REALIZADA EN LA PROVINCIA DE RESIDENCIA.</strong></p>\r\n<p>Antes de solicitar la cita para la expedici&oacute;n de la TIE, verifique si el expediente se encuentra en estado \"<strong>Resuelto favorable\" </strong>(<a href=\"https://sede.administracionespublicas.gob.es/procedimientos/index/categoria/34\" target=\"_blank\">enlace</a>), y que la concesi&oacute;n de su residencia o estancia lleva asociada la expedici&oacute;n de una TIE.&nbsp;En el caso de las tarjetas asociadas a la Ley 14/2013 de Apoyo a los Emprendedores, consultar en la Sede Electr&oacute;nica de la Unidad de Grandes Empresas (<a href=\"https://expinterweb.inclusion.gob.es/iley11/inicio/showTramites.action?procedimientoSel=200&amp;proc=1)\" target=\"_blank\">enlace</a>).</p></p>\r\n                \r\n                  \r\n                <p><p>La&nbsp;<strong>cita&nbsp;</strong>es&nbsp;<strong>personal</strong>, por lo que no se aceptar&aacute; una sola cita para diferentes miembros de la unidad familiar.</p>\r\n<p><strong><em>Se recuerda que la autorizaci&oacute;n concedida mediante resoluci&oacute;n de la Oficina de Extranjer&iacute;a o la Direcci&oacute;n General de Gesti&oacute;n Migratoria, una vez producida el alta en la Seguridad Social o la concesi&oacute;n de visado, en los casos que corresponda, produce plenos efectos frente a la administraci&oacute;n y frente a terceros y su eficacia no se encuentra condicionada a la obtenci&oacute;n de la Tarjeta de Identidad de Extranjero, sin perjuicio de que, de conformidad con el art&iacute;culo 4.2 de la Ley Org&aacute;nica 4/2000, de 11 de enero, deba ser solicitada en el plazo de un mes desde su concesi&oacute;n.</em></strong></p>\r\n<p>En el caso de estancias de Familiares de Estudiantes (<strong><em>visado SLF</em></strong>), se debe pasar, con antelaci&oacute;n a la cita de expedici&oacute;n de la TIE, por la Oficina de extranjer&iacute;a correspondiente para que sea grabada la autorizaci&oacute;n de estancia.</p>\r\n<p>No se expedir&aacute; TIE cuando vigencia de la autorizaci&oacute;n de extranjer&iacute;a a la que est&eacute; asociada sea inferior o igual a&nbsp;<strong>6 meses</strong>, ni en el caso de que la validez de la tarjeta que vaya a ser expedida sea inferior a&nbsp;<strong>30 d&iacute;as</strong>.</p>\r\n<p><strong>DOCUMENTACI&Oacute;N / INFORMACI&Oacute;N ADICIONAL PARA LA EXPEDICI&Oacute;N DE LA TARJETA DE IDENTIDAD DE EXTRANJERO:</strong></p>\r\n<ul>\r\n<li><strong>Justificante&nbsp;</strong>de la&nbsp;cita&nbsp;previa reservada.</li>\r\n<li><strong>Formulario de solicitud&nbsp;</strong>modelo&nbsp;<strong><a href=\"https://www.inclusion.gob.es/documents/d/migraciones/ex17-formulario-solicitud-tarjeta-de-identidad-de-extranjero-editable\" target=\"_blank\">EX-17(pdf)</a></strong>, debidamente cumplimentado y firmado por el interesado o su representante legal.</li>\r\n<li><strong>Formulario de solicitud&nbsp;</strong>espec&iacute;fico en el caso que la TIE que se va a expedir est&eacute; asociada a la&nbsp;<strong>Ley 14/2013 de Apoyo a los Emprendedores</strong>, debidamente cumplimentado y firmado por el interesado o su representante legal, (<a href=\"https://www.inclusion.gob.es/documents/410169/2156463/MI_TIE_NOV_2018.pdf\" target=\"_blank\">enlace</a>).</li>\r\n<li><strong>Documento acreditativo de identidad</strong>, original y en vigor.&nbsp;<strong><em>(Original</em></strong>). Siendo &uacute;nicamente v&aacute;lidos los siguientes:\r\n<ol>\r\n<li>Pasaporte de su pa&iacute;s.</li>\r\n<li>C&eacute;dula de inscripci&oacute;n de extranjeros indocumentados expedida por las autoridades espa&ntilde;olas.</li>\r\n<li>T&iacute;tulo de viaje, v&aacute;lidamente expedido y reconocido por Espa&ntilde;a.</li>\r\n</ol>\r\n</li>\r\n</ul>\r\n<p style=\"padding-left: 60px;\">Acorde al derecho de la Uni&oacute;n Europea, tanto los pasaportes como los t&iacute;tulos de viaje deber&aacute;n haberse expedido dentro de los diez a&ntilde;os anteriores a la fecha de presentaci&oacute;n ante la Autoridad que lo requiera.</p>\r\n<ul>\r\n<li>Justificante del abono de la tasa&nbsp;<a href=\"https://sede.policia.gob.es:38089/Tasa790_012/\" target=\"_blank\"><strong>Modelo 790</strong></a><strong>&nbsp;C&oacute;digo 012&nbsp;</strong>del Ministerio del Interior. El ejemplar debe estar correctamente impreso en su totalidad, no admiti&eacute;ndose en ning&uacute;n caso impresiones en las que no aparezca la parte inferior del documento, en la que consta la&nbsp;<em>anotaci&oacute;n&nbsp;<strong>&ldquo;Ejemplar para la Administraci&oacute;n&rdquo;</strong></em>. El impreso se descarga desde la p&aacute;gina web de la Polic&iacute;a.</li>\r\n</ul></p>\r\n                \r\n\t\t\t\t<p><p><strong>NO SE PUEDE FOTOCOPIAR EL IMPRESO DE LA TASA&nbsp;</strong>ya que cada documento est&aacute; reconocido con un identificador &uacute;nico.</p>\r\n<p>En el caso de que haya sido abonado el&nbsp;<strong>M&oacute;delo 790, c&oacute;d. 012&nbsp;</strong>de manera indebida, tendr&aacute; que ser tramitada la devoluci&oacute;n de dicha tasa&nbsp;<strong>presencialmente&nbsp;</strong>en la Unidad de Documentaci&oacute;n donde fue expedida la Tarjeta de Identidad de Extranjero, o en su defecto, donde obtuvo la cita con tal prop&oacute;sito. En ning&uacute;n caso debe ser solicitada la devoluci&oacute;n a trav&eacute;s de registro.</p>\r\n<ul>\r\n<li>Una&nbsp;<strong>fotograf&iacute;a reciente en color&nbsp;</strong>del rostro del solicitante, tama&ntilde;o 32x26 mil&iacute;metros, con fondo uniforme blanco y liso, tomada de frente con la cabeza totalmente descubierta y sin gafas de cristales oscuros o cualquier otra prenda que pueda impedir o dificultar la identificaci&oacute;n de la persona. (La fotograf&iacute;a deber&aacute; mostrar claramente el &oacute;valo de la cara, que incluye cejas, ojos, nariz, boca y ment&oacute;n, y deber&aacute; ser de alta resoluci&oacute;n y en papel fotogr&aacute;fico de buena calidad).</li>\r\n<li><strong>Certificado o Volante de empadronamiento&nbsp;</strong>actual (expedido en los tres &uacute;ltimos meses), en caso de que haya cambiado de domicilio. Para los titulares de autorizaciones de residencia como&nbsp;<strong>inversores&nbsp;</strong>o&nbsp;<strong>movilidad intraempresarial</strong>&nbsp;de la Ley 14/2013,&nbsp;<strong>y sus respectivos familiares</strong>, no es un requisito imprescindible.&nbsp;<strong><em>Original y copia</em></strong>.</li>\r\n<li><strong>Resoluci&oacute;n de concesi&oacute;n&nbsp;</strong>del permiso de residencia o estancia emitida por la oficina de la Delegaci&oacute;n del Gobierno o de la Direcci&oacute;n General de Gesti&oacute;n Migratoria, en los casos en los que se la hayan facilitado.</li>\r\n<li>En caso de que no sea la primera vez que se les expide una Tarjeta de Identidad de Extranjero (TIE), traer la anterior. En su defecto&nbsp;<strong>denuncia&nbsp;</strong>de extrav&iacute;o o sustracci&oacute;n.</li>\r\n<li>Los&nbsp;<strong>menores&nbsp;</strong>deber&aacute;n ir acompa&ntilde;ados de su representante legal debidamente acreditado y con documentaci&oacute;n de identidad original y en vigor, o por la persona apoderada por estos.</li>\r\n</ul>\r\n<p>Los documentos que deber&aacute;n ser presentados para acreditar la relaci&oacute;n con el menor son:</p>\r\n<ol>\r\n<li>Documentos de identidad, originales y en vigor, en todo caso.</li>\r\n<li>Menor nacido en Espa&ntilde;a. Libro de Familia o certificado de nacimiento del Registro Civil, o sentencia judicial de la tutela.</li>\r\n<li>Menor nacido en el extranjero. Partida de nacimiento o documentos de la tutela del menor traducidos (seg&uacute;n necesidad) y legalizados, bien con Apostilla de la Haya o v&iacute;a diplom&aacute;tica.</li>\r\n<li>Para acreditar el apoderamiento: Poder notarial expedido en Espa&ntilde;a. Poder notarial realizado fuera de Espa&ntilde;a, traducido (seg&uacute;n necesidad) y legalizado, bien con Apostilla de la Haya o a trav&eacute;s de la v&iacute;a diplom&aacute;tica.</li>\r\n</ol>\r\n<ul>\r\n<li>Si los menores son estudiantes con visado&nbsp;<strong>SME</strong>, deber&aacute;n aportar el informe favorable de la Delegaci&oacute;n del Gobierno y venir acompa&ntilde;ados &uacute;nicamente por la persona autorizada en dicho informe.</li>\r\n<li>En el caso de la expedici&oacute;n de la TIE asociada a los&nbsp;<strong>trabajadores transfronterizos&nbsp;</strong>deber&aacute; ser aportada por estos la resoluci&oacute;n de concesi&oacute;n de la Subdelegaci&oacute;n del Gobierno.&nbsp;<strong><em>Original y copia</em></strong>.</li>\r\n</ul></p>\r\n                \r\n\t\t\t\t<p><p><strong>INFORMACI&Oacute;N ADICIONAL PARA LA EXPEDICI&Oacute;N DE DUPLICADO DE TARJETA DE IDENTIDAD DE EXTRANJERO (T.I.E.)</strong></p>\r\n<p>Casos en los que procede la solicitud del duplicado:</p>\r\n<ol>\r\n<li>Sustracci&oacute;n, p&eacute;rdida o deterioro de la tarjeta.</li>\r\n<li>Modificaci&oacute;n de datos de filiaci&oacute;n o domicilio.</li>\r\n<li>Subsanaci&oacute;n de alg&uacute;n error en la impresi&oacute;n / soporte de la tarjeta.</li>\r\n</ol>\r\n<ul>\r\n<li>En caso de p&eacute;rdida o sustracci&oacute;n de la tarjeta:&nbsp;<strong>Denuncia&nbsp;</strong>original en Castellano o lengua cooficial de la CCAA donde se presente, en la que consten los datos del titular de la tarjeta y se haga menci&oacute;n expresa a la p&eacute;rdida o sustracci&oacute;n de la TIE.</li>\r\n<li>En caso de que exista una modificaci&oacute;n de los datos de filiaci&oacute;n:&nbsp;<strong>Certificado consular de concordancia&nbsp;</strong>(<a href=\"https://www.exteriores.gob.es/es/ServiciosAlCiudadano/Paginas/Legalizacion-y-apostilla.aspx\" target=\"_blank\">legalizado en el Servicio del Ministerio de Asuntos Exteriores, Uni&oacute;n Europea y Cooperaci&oacute;n de Espa&ntilde;a</a>)<strong>&nbsp;y pasaporte anterior&nbsp;</strong>(anulado o caducado). (<strong><em>Original&nbsp;</em></strong>y&nbsp;<strong><em>copia</em></strong><em>)</em></li>\r\n<li>En caso de adquisici&oacute;n de una nueva nacionalidad diferente a la que se ha utilizado para obtener el permiso de residencia o tarjeta de identidad previos:&nbsp;<strong>Certificado de inscripci&oacute;n consular&nbsp;</strong>actualizado de la nueva nacionalidad (<a href=\"https://www.exteriores.gob.es/es/ServiciosAlCiudadano/Paginas/Legalizacion-y-apostilla.aspx\" target=\"_blank\">legalizado en el Servicio del Ministerio de Asuntos Exteriores, Uni&oacute;n Europea y Cooperaci&oacute;n de Espa&ntilde;a</a>) junto con el pasaporte acreditativo de la misma. (<strong><em>Original&nbsp;</em></strong>y&nbsp;<strong><em>copia</em></strong>). En el caso de que usted sea titular de un&nbsp;<strong>permiso de residencia temporal&nbsp;</strong>esta comunicaci&oacute;n de cambio de nacionalidad debe hacerla a la Oficina de Extranjer&iacute;a correspondiente.</li>\r\n</ul>\r\n<p>&nbsp;</p>\r\n<p><strong>INFORMACI&Oacute;N ADICIONAL PARA LA EXPEDICI&Oacute;N DE LA TARJETA ASOCIADA AL ACUERDO DE RETIRADA DE CIUDADANOS BRIT&Aacute;NICOS Y SUS FAMILIARES (<em>BREXIT</em>)</strong></p>\r\n<p>Para acceder a este tr&aacute;mite tiene que ser titular de uno de los siguientes documentos:</p>\r\n<ol>\r\n<li>Certificado de Registro de Ciudadano de la Uni&oacute;n.</li>\r\n<li>Tarjeta de Familiar de Ciudadano de la Uni&oacute;n (Brit&aacute;nico o de Irlanda del Norte).</li>\r\n<li>Resoluci&oacute;n favorable emitida por las Oficinas de Extranjer&iacute;a. Para verificar si el expediente se encuentra en estado \"<strong><em>Resuelto favorable</em>\"&nbsp;</strong><a href=\"https://sede.administracionespublicas.gob.es/procedimientos/index/categoria/34\" target=\"_blank\">(enlace siguiente).</a></li>\r\n</ol>\r\n<ul>\r\n<li><strong>Formulario de solicitud&nbsp;</strong>modelo&nbsp;<a href=\"https://www.inclusion.gob.es/documents/410169/2156469/23-Formulario_TIE_RU.pdf\" target=\"_blank\"><strong>EX-23</strong></a>, debidamente cumplimentado y firmado por el interesado o su representante legal&nbsp;<a href=\"https://www.inclusion.gob.es/documents/410169/2156469/23-Formulario_TIE_RU.pdf\" target=\"_blank\">(enlace siguiente).</a></li>\r\n<li><strong>Pasaporte v&aacute;lido y en vigor del solicitante.&nbsp;</strong>En el supuesto de que el pasaporte est&eacute; caducado deber&aacute; aportar copia de este y de la solicitud de renovaci&oacute;n. En el momento de la recogida de la tarjeta el Pasaporte tiene que estar en vigor.&nbsp;<strong><em>(Original).</em></strong></li>\r\n</ul>\r\n<p>&nbsp;<strong>PREGUNTAS FRECUENTES (FAQ)&nbsp;</strong><a href=\"https://www.policia.es/_es/extranjeria_extranjeros.php#Nueve\" target=\"_blank\"><strong>(enlace siguiente)</strong></a></p></p>\t\t\t\r\n\t\t</div>\t\r\n        \r\n\r\n\t<div>\t\r\n\t\t<div class=\"mf-note\">\r\n\t\t\t\t<strong>LEE ATENTAMENTE</strong>\r\n\t\t\t     <span><p>&nbsp;</p>\r\n<p>Las personas solicitantes de Tarjeta de Identidad de Extranjero, beneficiarias del tr&aacute;mite de protecci&oacute;n temporal para personas desplazadas por el <strong>CONFLICTO DE UCRANIA</strong>, deben seleccionar la cita espec&iacute;fica <strong style=\"color: red;\">POLIC&Iacute;A-TARJETA CONFLICTO UCRANIA - ПОЛІЦІЯ - КАРТКА ДЛЯ ПЕРЕМІЩЕНИХ ОСІБ ВНАСЛІДОК КОНФЛІКТУ В УКРАЇНІ</strong>, por lo que &ldquo;<strong>NO&rdquo;</strong> ser&aacute;n atendidas, si reservan la cita gen&eacute;rica POLIC&Iacute;A-TOMA DE HUELLA (EXPEDICI&Oacute;N DE TARJETA) INICIAL, RENOVACI&Oacute;N, DUPLICADO Y LEY 14/2013.</p>\r\n<p><strong><em><span style=\"color: red;\">Si usted desconoce su N&ordm; de NIE (N&uacute;mero de Identificaci&oacute;n de Extranjeros) env&iacute;e copia de pasaporte y visado, por correo electr&oacute;nico a&nbsp;<a href=\"mailto:consultanie.cantabria@policia.es\">consultanie.cantabria@policia.es</a>&nbsp;y le ser&aacute; facilitado.</span></em></strong>&nbsp;</p>\r\n<p><span style=\"color: red;\">La utilizaci&oacute;n de certificado electr&oacute;nico (Cl@ve, certificado digital de la FNMT o DNIe), en la reserva de cita previa, garantiza mayor accesibilidad en el proceso de reserva.</span></p>\r\n<p><span style=\"color: red;\">Si todav&iacute;a no disponen de acceso al certificado electr&oacute;nico, pueden solicitar la cita a trav&eacute;s de cualquier entidad o persona que disponga de &eacute;l, y podr&aacute;n reservar la cita en su nombre.</span></p></span>\r\n\t\t</div>  \r\n\t\t<br/>\r\n\t\t\t\r\n\t\t\t\r\n\t \r\n\t\t\t<div>\r\n\t\t\t\t<div class=\"mf-header__compact mf-layout--row\">\r\n\t\t            <div id=\"btnAccesoClave\" class=\"mf-layout--module__s mf-header--container mf-flexgrid--box mf-button__primary\">\r\n\t\t            \t<p class=\"mf-paragraph-header pint\">Presentaci&oacute;n con Cl@ve</p>\r\n\t\t              \t<p  class=\"tjus\">\r\n\t\t              \t\t<span>A continuaci&oacute;n puedes acceder a la reserva de la cita, para el tr&aacute;mite y la provincia seleccionados, mediante el uso de cl@ve.</span> <span>En caso de utilizar certificado digital, por favor, aseg&uacute;rate de que lo tienes correctamente instalado y funcionando.</span>\r\n\t\t              \t</p>\r\n\t\t\t\t\t\t\t\t\r\n\t\r\n\t\t\t\t\t\t\t\t<input id=\"acceso\" name=\"acceso\" type=\"hidden\" value=\"N\"/>\r\n\t\t\t        </div>\r\n\t\t            <div id=\"btnEntrar\" class=\"mf-layout--module__s mf-header--container mf-flexgrid--box mf-button__secondary\" onClick=\"document.forms[0].submit()\">\r\n\t\t            \t<p class=\"mf-paragraph-header pint\">Presentaci&oacute;n sin Cl@ve</p>\r\n\t\t              \t<p  class=\"tjus\">\r\n\t\t              \t\t<span>A continuaci&oacute;n puedes acceder a la reserva de la cita, para el tr&aacute;mite y la provincia seleccionados, sin el uso de cl@ve.</span>\r\n\t\t              \t</p>\t\t\t\r\n\t\r\n\t\t\t                \r\n\t\t\t        </div>\r\n\t\t\t    </div>\r\n\t\t\t\t\t\t<p  class=\"tjus\" style=\"margin-left: 30px\">\r\n\t\t\t\t\t\t\t<a target=\"_blank\" href=\"https://clave.gob.es/clave_Home/clave.html\" class=\"iconOut\" >\r\n\t\t\t\t\t\t\t\t<span class=\"ma-icons__icon mf-icon mf-icon-info\"></span>\r\n\t\t\t\t\t\t\t\t<span>M&aacute;s informaci&oacute;n sobre cl@ve</span>\t\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</p>\r\n\t\r\n\t\t\t\t<input id=\"btnVolver\" type=\"button\" class=\"mf-button secondary\" value=\"Volver\" onClick=\"goVolverPortada();\"/>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t  </div>\r\n\r\n\t</form>\r\n\t</div>\r\n\t</section>\r\n\t</div>\r\n\t</div>\r\n\t<script type=\"text/javascript\">\r\n\t\t\r\n \t\t    $('document').ready(function(){\r\n \t\t        $('#btnAccesoClave').click( function(e){ \t\t        \t\r\n \t\t            $('#acceso').val(\"C\");\r\n \t\t           \tdocument.info.submit();\r\n \t\t        });\r\n \t\t    });\r\n \t</script> \r\n\t</main>\r\n\t</div>\r\n\t</div>\r\n\t<footer id=\"footerNew\" class=\"mf-footer noprint\"><div class=\"mf-footer--container\">   \t  \n      <ul id=\"footermenu\" class=\"mf-footer--menu\">\n            <li class=\"mf-footer--menu-item\"><a href=\"accesibilidad\" target=\"_blank\">Accesibilidad</a></li>\n            <li class=\"mf-footer--menu-item\"><a href=\"avisolegal\" target=\"_blank\">Aviso legal</a></li>\n            <li class=\"mf-footer--menu-item\"><a href=\"contacto\" target=\"_blank\">Contacto</a></li>\n    </ul><p id=\"copyright\" class=\"mf-footer--copy\">&copy; <span>Agencia Estatal de Administración Digital</span>\n \t\t\t\n\t</p>\t\t\n    </div></footer>\r\n\t<div id=\"cookie-law-info-bar\" class=\"noprint\">\r\n\t\t<span>Utilizamos cookies propias y de terceros para mejorar nuestros servicios Si continúa navegando, consideramos que acepta su uso. Puede obtener más información, o bien conocer cómo cambiar la configuración, en nuestra <strong>política de uso de cookies</strong>. &nbsp;&nbsp;<a href=\"#\" id=\"cookie_action_close_header\" class=\"small cli-plugin-button cli-plugin-main-button\">Acepto</a> - <a href=\"#\" onclick=\"goPoliticaCookies()\" class=\"small cli-plugin-button cli-plugin-main-button\">Política de uso de cookies</a></span>  \r\n\t</div>\r\n\t\r\n\t<form name=\"politicaCookiesForm\" id=\"politicaCookiesForm\" method=\"post\" action=\"/icpplus/politicaCookies\" target=\"_blank\"><input type=\"hidden\" name=\"d72b307a-c9b1-4c5f-84a0-be64dbb119e9\" value=\"a17e82fd-e4a9-4d74-954c-6e7a77685196\"/><input type=\"hidden\" name=\"c8038f18-2658-4836-acae-3042880627f8\" value/>\r\n\t\t<input type=\"hidden\" name=\"method\" value=\"politicaCookies\"/>\r\n\t</form>\r\n\t <script type=\"text/javascript\">\r\n      //<![CDATA[  \t  \r\n   \t  \r\n   \t  \r\n      jQuery(document).ready(function() {  \r\n    \t  \r\n        cli_show_cookiebar({\r\n          settings: '{\