ment.getElementById('politicaCookiesForm').submit();\r\n\t  \t}\r\n\t\t\r\n\t\t//DESHABILITAMOS EL BOTÓN ATRÁS DEL NAVEGADOR\r\n\t\tif (history.forward(1)){location.replace(history.forward(1))}\t\r\n    </script>\r\n    <script>\r\n    \t$(document).ready(function(){\t\t\r\n\t    \t/*\r\n\t    \t * Class para no permitir la acción pegar\r\n\t    \t */\r\n\t    \t  $(\".noPaste\").on('paste', function(e){\r\n\t    \t    e.preventDefault();\r\n// \t\t\t\t$.alert({\r\n// \t\t\t\t    title: false,\r\n// \t\t\t\t    content: 'Esta acción está prohibida',\r\n// \t\t\t\t    buttons: {\r\n// \t\t\t\t    \taceptar: function () {\r\n// \t\t\t\t        }\r\n// \t\t\t\t    }\r\n// \t\t\t\t});\r\n\t    \t    alert('Esta acción está prohibida');\r\n\t    \t  })\r\n\t    \t  \r\n\t    \t/*\r\n\t    \t * Class para no permitir la acción copiar\r\n\t    \t */\r\n\t    \t  $(\".noCopy\").on('copy', function(e){\r\n\t    \t    e.preventDefault();\r\n// \t\t\t\t$.alert({\r\n// \t\t\t\t    title: false,\r\n// \t\t\t\t    content: 'Esta acción está prohibida',\r\n// \t\t\t\t    buttons: {\r\n// \t\t\t\t    \taceptar: function () {\r\n// \t\t\t\t        }\r\n// \t\t\t\t    }\r\n// \t\t\t\t});\r\n\t    \t    alert('Esta acción está prohibida');\r\n\t    \t  })\r\n    \t})\r\n\t</script>\r\n\t<script></script>\r\n</body>\r\n</html>\r\n\r\n\t\r\n    \r\n    \r\n    "},"headersSize":976,"bodySize":54091,"redirectURL":"","_transferSize":55067},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":436.536,"receive":338.112},"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":64115,"_securityDetails":{"protocol":"TLS 1.2","subjectName":"*.administracionelectronica.gob.es","issuer":"RapidSSL TLS RSA CA G1","validFrom":1758153600,"validTo":1791590399}},{"pageref":"page@d15766e800bd234be767d850e12fdd9b","startedDateTime":"2026-08-27T05:19:02.864Z","time":386.072,"request":{"method":"POST","url":"https://icp.administracionelectronica.gob.es/icpplus/rb_38993f78-c97c-