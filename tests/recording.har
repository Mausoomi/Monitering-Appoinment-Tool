7db29ea9e27553b8f971000b561c?type=17\"></script>\r\n\r\n<title>Proceso automático para la solicitud de cita previa</title>\r\n<meta charset=\"utf-8\" />\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\r\n<meta http-equiv=\"cache-control\" content=\"no-store, no-cache, must-revalidate,max-age=0\" />\r\n<meta http-equiv=\"expires\" content=\"-1\" />\r\n<meta http-equiv=\"expires\" content=\"Tue, 01 Jan 1980 1:00:00 GMT\" />\r\n<meta name=\"robots\" content=\"noodp\" />\r\n<meta http-equiv=\"pragma\" content=\"no-cache\" />\r\n<meta name=\"description\" content=\"Portal web para que el ciudadano solicite por internet cita en las Oficinas Unicas de Extranjería\" />\r\n<meta name=\"keywords\" content=\"Cita previa, Cita extranjeria, extranjeria españa\" />\r\n\r\n<!--\r\n<title th:text=\"#{tit_cabecera}\">Proceso autom&aacute;tico para la solicitud de cita previa</title>\r\n<meta name=\"description\" content=\"Portal web para que el ciudadano solicite por internet cita en las Oficinas Unicas de Extranjer&iacute;a\" />\r\n-->\r\n\r\n\r\n<script type=\"text/javascript\" src=\"/icpplus/ruxitagentjs_ICANVfghqru_10343260715123811.js\" data-dtconfig=\"app=fc0be45c7c7075ff|cuc=ouei22vu|owasp=1|mel=100000|featureHash=ICANVfghqru|dpvc=1|md=mdcc1=bnavigator.userAgent|lastModification=1787548648315|tp=500,50,0|rdnt=1|uxrgce=1|srbbv=2|agentUri=/icpplus/ruxitagentjs_ICANVfghqru_10343260715123811.js|reportUrl=/icpplus/rb_38993f78-c97c-4ab5-8f9e-8df5e35f736d|rid=RID_334937774|rpid=485943200|domain=administracionelectronica.gob.es\"></script><link rel=\"shortcut icon\" href=\"/icpplus/resources/css/eSede/images/logo.ico\" />\r\n<link rel=\"stylesheet\" href=\"/icpplus/resources/css/font-awesome-4.7.0/css/font-awesome.min.css?v=V%207.50.2\">\r\n<link rel=\"stylesheet\" href=\"/icpplus/resources/css/eu-captcha/eu-captcha-style.css?v=V%207.50.2\">\r\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css\">\r\n<link href=\"/icpplus/resources/css/jquery-confirm.css\" type=\"text/css\" rel=\"stylesheet\"  />\r\n<link href=\"/icpplus/resources/css/morfos/grid-min.css?v=V%207.50.2\" type=\"text/css\" rel=\"stylesheet\"  />\r\n<link href=\"/icpplus/resources/css/morfos/styles-sede.css\" type=\"text/css\" rel=\"stylesheet\"  />\r\n\r\n<link href=\"/icpplus/resources/css/eSedeMPT/cssEsede_icp-6.50.1.css?v=7.50.2\" type=\"text/css\" rel=\"stylesheet\"  />\n<link href=\"/icpplus/resources/css/jquery-ui-6.50.1.css\" type=\"text/css\" rel=\"stylesheet\"/>\r\n<link href=\"/icpplus/resources/css/icp-7.29.css?v=V%207.50.2\" type=\"text/css\" rel=\"stylesheet\"/>\r\n\r\n<script src=\"/icpplus/resources/js/icp-7.37.min.js?v=V%207.50.2\"></script>\n\r\n<script src=\"/icpplus/resources/js/cookielawinfo.js?v=V%207.50.2\"></script>\r\n<script src=\"/icpplus/resources/js/jquery-3.5.1.min.js\"></script>\r\n<script src=\"/icpplus/resources/js/jquery-ui.js\"></script>\r\n<script src=\"/icpplus/resources/js/jquery-confirm.js\"></script>\r\n\r\n\r\n<script src=\"/icpplus/resources/js/morfos/modernizr.js\"></script>\r\n<script src=\"/icpplus/resources/js/morfos/datepicker.js\"></script>\r\n<script src=\"/icpplus/resources/js/morfos/morfos.js\"></script>\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\tvar ua = \"UA-33444577-1\";\r\n\tvar _gaq = _gaq || [];\r\n  \t_gaq.push(['_setAccount', ua]);\r\n  \t_gaq.push(['_trackPageview']);\r\n\r\n  \t(function() {\r\n  \t\tif(ua!='null' && ua!=''){\r\n\t    \tvar ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;\r\n\t    \tga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';\r\n\t    \tvar s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);\r\n  \t\t}\r\n  \t})(); \r\n</script>\r\n\r\n\r\n\r\n\r\n\r\n\r\n</head>\r\n\r\n\r\n<body class=\"sede \">\r\n\r\n\t<div id=\"container\" class=\"mf-container\">\r\n\t\r\n    <noscript>\r\n\t    <div id=\"noJS\" class=\"ac-msg__no-js\" role=\"alert\">\r\n\t        <p class=\"mf-paragraph-header\">\r\n\t            JavaScript desactivado        </p>\r\n\t        <p>\r\n\t            Es posible que JavaScript no esté activado en su navegador y es necesario para el funcionamiento de este\r\n\t                    sitio.            Por favor, actívelo para poder continuar y recargue la página.        </p>\r\n\t    </div>\r\n\t</noscript>\r\n\r\n\r\n\r\n\r\n\r\n\t<header id=\"header\" class=\"mf-header noprint\" role=\"banner\">\r\n\t\t<div class=\"mf-header--container\">\n        <div class=\"mf-header--logo\">\n            <p class=\"mf-logo\">\n                <span class=\"mf-logo--link\">\n                \t<img class=\"mf-logo--img\" src=\"data:image/png;base64,\" \n                \t\talt=\"Extranjería\" />                \t\n\t\t\t\t\t\n                </span>\n                \n            </p>\n        </div>\n        \n        <div id=\"topBar\" class=\"mf-topbar\">\n        \t<button class=\"mf-topbar-button\"><span>Opciones</span></button>          \n            <div class=\"mf-topbar-veil\"></div>\n            <div class=\"mf-topbar--container\">\n                <ul id=\"accMenu\" class=\"mf-accesibility-menu\">\n                    <li class=\"mf-accesibility-item\"><a id=\"accGotoContent\" class=\"mf-topbar--item\" href=\"#wrap\">Ir al contenido</a></li>\n                    <li class=\"mf-accesibility-item\"><a class=\"mf-topbar--item\" href=\"accesibilidad\" target=\"_blank\">Accesibilidad</a>\n                    </li>                    \n                </ul>                \n                \t\n            </div>\n        </div>\n        <div class=\"mf-header--content\">\n\n            <div class=\"mf-app-title--container\">\n                <h1 class=\"mf-app-title\">Sede electr&oacute;nica</h1>\n\t\t\t\t<p class=\"mf-app-subtitle\">Administraciones Públicas</p>\n            </div>\n\n            <div id=\"mainMenu\" class=\"mf-appmenu\">\n                <nav id=\"nav\" role=\"menubar\">\n                    <div class=\"mf-appmenu--title\">\n                        <button class=\"mf-appmenu--button\"><span>Men&amp;uacute; principal</span></button>\n                        <div class=\"mf-appmenu--veil\"></div>\n                    </div>\n\n                    <input type=\"hidden\" id=\"urlSede\" value=\"https://sede.administracionespublicas.gob.es/\"/>\n                    <ul class=\"mf-appmenu--menu\" role=\"navigation\">\n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\"><a href=\"https://sede.administracionespublicas.gob.es/\" onclick=\"goSalir($('#urlSede').val())\">INICIO</a></li>\n                        \n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\">\n                        \t<a href=\"https://sede.administracionespublicas.gob.es/procedimientos/\" onclick=\"goSalir($('#urlSede').val()+'procedimientos//')\"><span>PROCEDIMIENTOS</span></a>\n                        </li>\n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\">\n                        \t<a href=\"https://sede.administracionespublicas.gob.es/expedientes/\" onclick=\"goSalir($('#urlSede').val()+'expedientes/')\">MIS EXPEDIENTES</a></li>\n                        <li class=\"mf-appmenu--item mf-appmenu--item__L1\"><a\n                                href=\"https://sede.administracionespublicas.gob.es/mis-notificaciones/index\" onclick=\"goSalir($('#urlSede').val()+'mis-notificaciones/index')\">MIS NOTIFICACIONES</a></li>\n                         <li class=\"mf-appmenu--item mf-appmenu--item__L1\">\n                         \t<a href=\"https://sede.administracionespublicas.gob.es/pagina/index/directorio/ayuda_de_navegacion\"  onclick=\"goSalir($('#urlSede').val()+'pagina/index/directorio/ayuda_de_navegacion')\">Ayuda</a></li>\n\n\n                    </ul>\n\n                    \n                </nav>\n            </div>\n        </div>\n        \n\t\t<input type=\"hidden\" value=\"Vas a salir de la aplicación web de Cita Previa\n\n¿Estas seguro?\" id=\"litSalirSeguro\" />\n\t    <input type=\"hidden\" value=\"INTERNET CITA PREVIA\" id=\"litICP\" />\t    \n    </div>\r\n\t</header>\r\n\t<div id=\"wrap\" class=\"mf-wrapper\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\r\n\t<div class=\"mf-media\"><div class=\"mf-media--ext\">7.50.2</div></div>\r\n\r\n\t<input type=\"hidden\" name='alert_captcha' id='alert_captcha' value=\"Has introducido incorrectamente el código de la imagen\"/>\r\n    <input type=\"hidden\" name=\"lit_no_olvide_dato\" id=\"lit_no_olvide_dato\" value=\"No olvides introducir el dato:\" />\r\n    <input type=\"hidden\" name=\"lit_es_dato_obligatorio\" id=\"lit_es_dato_obligatorio\" value=\"Es un dato obligatorio\" />        \r\n    <input type=\"hidden\" name=\"alert_demasiado_corto\" id=\"alert_demasiado_corto\" value=\"Es demasiado corto.\" />\r\n    <input type=\"hidden\" name=\"lit_DebeComenzarPorLaLetra\" id=\"lit_DebeComenzarPorLaLetra\" value=\"Debe comenzar por la letra\" />\r\n    <input type=\"hidden\" name=\"lit_DebeAcabarPorUnaLetra\" id=\"lit_DebeAcabarPorUnaLetra\" value=\"Debe acabar por una letra\" />\r\n    <input type=\"hidden\" name=\"lit_Incorrecto\" id=\"lit_Incorrecto\" value=\"Incorrecto\" />\r\n    <input type=\"hidden\" name=\"lit_EsIncorrecto\" id=\"lit_EsIncorrecto\" value=\"Es incorrecto\" />\r\n    <input type=\"hidden\" name=\"lit_ElNIEIntroducidoEsIncorrectoPorFavorReviseloAntesDeContinuar\" id=\"lit_ElNIEIntroducidoEsIncorrectoPorFavorReviseloAntesDeContinuar\" value=\"El N.I.E. introducido es incorrecto, por favor revísalo antes de continuar\" />\r\n    <input type=\"hidden\" name=\"lit_ElFormatoDeLa0EsIncorrectoReviselo_formato\" id=\"lit_ElFormatoDeLa0EsIncorrectoReviselo_formato\" value=\"El formato de la {0} es incorrecto, revisalo.(dd/mm/aaaa)\" />\r\n    <input type=\"hidden\" name=\"lit_AVISO_CITA_PREVIA\" id=\"lit_AVISO_CITA_PREVIA\" value=\"AVISO CITA PREVIA\" />\r\n    <input type=\"hidden\" name=\"lit_PorFavorIntroduzcaLaFechaRequerida\" id=\"lit_PorFavorIntroduzcaLaFechaRequerida\" value=\"Por favor, introduce la fecha requerida\" />    \r\n    <input type=\"hidden\" name=\"lit_LaFechaIntroducidaEnElCampoDeFechaEsErronea\" id=\"lit_LaFechaIntroducidaEnElCampoDeFechaEsErronea\" value=\"La fecha introducida en el campo de fecha es errónea\" />\r\n    \r\n\t <script type=\"text/javascript\">\r\n      //<![CDATA[  \t  \r\n   \t  \r\n   \t  \r\n      jQuery(document).ready(function() {   \r\n    \t  var idioma = \"es\";\r\n    \t  if(idioma==null || idioma==''){\r\n    \t \tidioma='es';\r\n    \t  }\r\n\t\t  if( idioma!='en'){\r\n\t\t\tlet monthNamesShort = \"Ene,Feb,Mar,Abr,May,Jun,Jul,Ago,Sep,Oct,Nov,Dic\".split(',');\r\n\t\t\tlet dayNames = \"Domingo,Lunes,Martes,Mi\\u00E9rcoles,Jueves,Viernes,S\\u00E1bado\".split(',');\t\t\t\r\n\t  \t\t$.datepicker.regional[idioma] = {\r\n\t\t\t\t closeText: '\"Cerrar\"',\r\n\t\t\t\t prevText: '\"< Ant\"',\r\n\t\t\t\t nextText: '\"Sig >\"',\r\n\t\t\t\t currentText: '\"Hoy\"',\r\n\t\t\t\t monthNames: [ \"Enero\", \"Febrero\", \"Marzo\", \"Abril\", \"Mayo\", \"Junio\", \"Julio\", \"Agosto\", \"Septiembre\", \"Octubre\", \"Noviembre\", \"Diciembre\" ],\r\n\t\t\t\t monthNamesShort: monthNamesShort,\r\n\t\t\t\t monthStatus: '\"Ver otro mes\"', yearStatus: '\"Ver otro a\\u00F1o\"',\r\n\t\t\t\t dayNames: dayNames,\r\n\t\t\t\t dayNamesShort: \"Dom,Lun,Mar,Mi\\u00E9,Juv,Vie,S\\u00E1b\".split(','),\r\n\t\t\t\t dayNamesMin: \"Do,Lu,Ma,Mi,Ju,Vi,S\\u00E1\".split(','),\r\n\t\t\t\t weekHeader: 'Sm',\r\n\t\t\t\t dateFormat: 'dd/mm/yy',\r\n\t\t\t\t firstDay: 1,\r\n\t\t\t\t isRTL: false,\r\n\t\t\t\t showMonthAfterYear: false,\r\n\t\t\t\t yearSuffix: '',\r\n\t\t\t\t initStatus: '\"Selecciona la fecha\"'\r\n\t\t\t};\r\n\t\t  }\r\n    \t  $.datepicker.setDefaults($.datepicker.regional[idioma]);\r\n    \t  $.datepicker.setDefaults({\r\n    \t\t  showOn: \"button\",\r\n    \t\t  buttonImageOnly: true,\r\n    \t\t  buttonImage: \".\\\\static\\\\css\\\\morfos\\\\images\\\\calendario.gif\",\r\n    \t\t  dateFormat: 'dd/mm/yy'\r\n    \t  });\r\n\r\n      });      \r\n      //]]>\r\n\r\n      </script>\r\n      \r\n\t<main id=\"mainWindow\" class=\"ac-section mf-main\">\r\n    \t\r\n    <script type=\"application/ld+json\">{ \"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [ }]}</script>\r\n    \t\r\n    <div class=\"mf-layout--row\">\r\n    \r\n    <div class=\"mf-layout--main\">\r\n    <section class=\"mf-layout--main-content\">\r\n   \t<div class=\"mf-window-header\">\r\n\t\t  \r\n          <div >\r\n              <h2 class=\"mf-window-header--title\">CITA PREVIA EXTRANJERÍA</h2>\r\n          </div>                    \r\n    </div>\r\n\t<div class=\"mf-main--content ac-custom-content\">\r\n    \r\n    <form  id=\"portadaForm\" name=\"portadaForm\" action=\"acInfo\" method=\"post\"><input type=\"hidden\" name=\"b0202454-eb0a-4941-b68a-8af4236441f5\" value/><input type=\"hidden\" name=\"d72b307a-c9b1-4c5f-84a0-be64dbb119e9\" value=\"a17e82fd-e4a9-4d74-954c-6e7a77685196\"/>\r\n    \r\n\t<div>\t\r\n\t\t<div class=\"fld\">\r\n\t\t\t<label for=\"prov_selecc\" >PROVINCIA SELECCIONADA</label>\r\n\t\t\t<input id=\"prov_selecc\" type=\"text\" disabled=\"disabled\" readonly=\"readonly\" value=\"Cantabria\"/>\r\n\t\t</div>\r\n\t\t \r\n\t\t\r\n\t</div>\r\n\t<div class=\"fld\">\r\n\t\t<a href=\"#divMensajesProv\">Importante: lee toda la información de esta página, incluida la que se encuentra al final, antes de continuar.</a>\r\n\t</div>\r\n    \r\n\t<div>\r\n\t\t<div id=\"divListaDeSedes\">\t\t\t\r\n\r\n\t\t\t\r\n\t\t\t<div>\r\n\t\t\t<fieldset>\r\n<!-- \t\t\t\t<legend th:text=\"#{msj_selecciones_cita}\"> </legend> -->\r\n\r\n\t\t\t\t<div id=\"divSedes\" class=\"fld\">\r\n\t\t\t\t\t<label for=\"sede\">Selecciona Oficina:</label>\r\n\t\t\t\t\t<select name=\"sede\" id=\"sede\"\r\n\t\t\t\t\t\tdata-live-search=\"true\" title=\"Selecciona Oficina\"\r\n\t\t\t\t\t\tclass=\"mf-input__xl\" onchange=\"cargaTramites()\">\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<option value=\"99\">Cualquier oficina</option>\r\n\t\t\t\t\t\t<optgroup label=\"Elegir oficina\">\r\n\t\t\t\t\t\t\t<option value=\"6\" >CNP SANTANDER ASILO Y REFUGIO, Jose Ramón López Dóriga, 4, SANTANDER</option>\r\n\t\t\t\t\t\t\t<option value=\"5\" >CNP SANTANDER TRAMITES EXTRANJERIA,  ***  C/ LOPEZ DORIGA, 6, Santander</option>\r\n\t\t\t\t\t\t\t<option value=\"1\" >OFICINA EXTRANJERIA, Luis Hoyos Sáinz, 4, SANTANDER</option>\r\n\t\t\t\t\t\t\t<option value=\"3\" >POLICIA CASTRO URDIALES, CAYETANO TUEROS, 8, CASTRO URDIALES</option>\r\n\t\t\t\t\t\t\t<option value=\"2\" >POLICIA SANTANDER /TOMA DE HUELLA - TIES, JOSÉ RAMÓN LÓPEZ DÓRIGA, 6, SANTANDER</option>\r\n\t\t\t\t\t\t</optgroup>\r\n\t\t\t\t\t</select>\t\r\n\t\t\t\t\t<div class=\"error\">\r\n\t\t\t            <ul class=\"error_list\">\r\n\t\t\t                <li id=\"alert_seleccion_provincia_sede\" style=\"display:none\">Información de CITA PREVIA:\n\nDebes seleccionar la oficina donde quieres solicitar la cita.</li>\r\n\t\t\t            </ul>\r\n\t\t\t        </div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<p>La oficina seleccionada, será donde deberás acudir el día de presentación de la cita previa concedida.</p>\r\n\t\t\t</fieldset>\t\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<div id=\"divGrupoTramites\">\r\n\t\t\t\t\r\n\t\t\t<div class=\"fld\">                    \r\n\t\t\t<fieldset>  \t\r\n\t\t\t\t<legend>Selecciona trámite</legend>\r\n\t\t\t\t<div class=\"fld\">\r\n\t\t\t\t\t<label for=\"tramiteGrupo[0]\">TRÁMITES OFICINAS DE EXTRANJERÍA</label>\t\t\t\t                    \r\n\t\t\t\t    <select name=\"tramiteGrupo[0]\" id=\"tramiteGrupo[0]\" onchange=\"eliminarSeleccionOtrosGrupos(0);cargaMensajesTramite()\" class=\"mf-input__l\">\r\n\t\t\t\t\t\t<option value='-1'>Despliega para ver trámites disponibles en esta provincia</option>\r\n\t\t\t\t\t\t<option value='4009'>INFORMACIÓN</option>\r\n\t\t\t\t\t\t<option value='4059'>RENOVACIONES, PRÓRROGAS Y MODIFICACIONES</option>\r\n\t\t\t\t\t\t<option value='23'>RESIDENCIA INICIAL</option>\r\n\t\t\t\t\t</select>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"fld\">\r\n\t\t\t\t\t<label for=\"tramiteGrupo[1]\">TRÁMITES POLICÍA NACIONAL</label>\t\t\t\t                    \r\n\t\t\t\t    <select name=\"tramiteGrupo[1]\" id=\"tramiteGrupo[1]\" onchange=\"eliminarSeleccionOtrosGrupos(1);cargaMensajesTramite()\" class=\"mf-input__l\">\r\n\t\t\t\t\t\t<option value='-1'>Despliega para ver trámites disponibles en esta provincia</option>\r\n\t\t\t\t\t\t<option value='4036'>POLICIA - RECOGIDA DE TARJETA DE IDENTIDAD DE EXTRANJERO (TIE)</option>\r\n\t\t\t\t\t\t<option value='4092'>POLICIA - TÍTULOS DE VIAJE</option>\r\n\t\t\t\t\t\t<option value='4078'>POLICIA- SOLICITUD ASILO</option>\r\n\t\t\t\t\t\t<option value='20'>POLICIA-AUTORIZACIÓN DE REGRESO</option>\r\n\t\t\t\t\t\t<option value='4037'>POLICIA-CARTA DE INVITACIÓN</option>\r\n\t\t\t\t\t\t<option value='4038'>POLICIA-CERTIFICADO DE REGISTRO DE CIUDADANO DE LA U.E.</option>\r\n\t\t\t\t\t\t<option value='4049'>POLICIA-CERTIFICADOS (DE RESIDENCIA, DE NO RESIDENCIA Y DE CONCORDANCIA)</option>\r\n\t\t\t\t\t\t<option value='4097'>POLICIA-INFORMACION DE TRÁMITES DE LA COMISARÍA DE POLICIA</option>\r\n\t\t\t\t\t\t<option value='4099'>POLICÍA - CÉDULA DE INSCRIPCIÓN</option>\r\n\t\t\t\t\t\t<option value='4112'>POLICÍA TARJETA CONFLICTO UCRANIA–ПОЛІЦІЯ -КАРТКА ДЛЯ ПЕРЕМІЩЕНИХ ОСІБ ВНАСЛІДОК КОНФЛІКТУ В УКРАЇНІ</option>\r\n\t\t\t\t\t\t<option value='4086'>POLICÍA-RECOGIDA DE TARJETA ROJA (PROTECCIÓN INTERNACIONAL)</option>\r\n\t\t\t\t\t\t<option value='4010'>POLICÍA-TOMA DE HUELLAS (EXPEDICIÓN DE TARJETA) INICIAL, RENOVACIÓN, DUPLICADO Y LEY 14/2013</option>\r\n\t\t\t\t\t</select>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"error\">\r\n\t\t            <ul class=\"error_list\">\r\n\t\r\n\t\t                <li id=\"mensajeErrorTramite\" style=\"display:none\">Debes seleccionar un tramite</li>\r\n\t\t            </ul>\r\n\t\t        </div>\t\t\t\t\t\t\t\t\t\t\t \r\n\t\t\t\t<p class=\"mf-msg__error\" id=\"mensajeError\" style=\"display:none\">Se ha producido un error. Por favor, recarga de nuevo la p&amp;aacute;gina.</p>\r\n\t\t\t</fieldset>\r\n\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t\r\n\t\t<div id=\"divMensajesTramite\" class=\"mf-layout--row\">\r\n\t\t\t\r\n\t\t\t\r\n\t\t</div>\r\n\t\t\t\r\n\t\t<div id=\"divSubTramites\" style=\"display: none\">\t\t\t\t\t                    \r\n\t\t\t<table>\r\n\t        <tr>\r\n\t\t\t\t<td  class=\"tituloTabla\" >\r\n\t\t\t\t\t<label for=\"subtramite\">MÁS TRÁMITES EN LA PROVINCIA SELECCIONADA</label>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>                       \r\n\t                    \r\n\t\t        <tr>\r\n\t\t\t\t\t<td id=\"subtramites\">\r\n\t\t\t\t\t\t<select name='subtramite' id='subtramite' class=\"selectpicker form-control\" >\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</select>\r\n\t                      </td>\r\n\t\t\t\t</tr>   \r\n\t\t\t</table>\r\n\t\t</div>\r\n\t\t\r\n\t</div>\r\n\t\t\t\t\t\t\t\r\n\t\r\n\t<div class=\"mf-layout--row layout--abajo\">\t\t\t                                \t\t\t\t\r\n        <input id=\"btnAceptar\" type=\"button\" class=\"mf-button primary\" value=\"Aceptar\" onclick=\"envia()\" />                           \r\n\t\t<input id=\"btnVolver\" type=\"button\" class=\"mf-button secondary\" value=\"Volver\" onclick=\"goSalirInicio();\" />\t\t                           \r\n\t\t\r\n    </div>\r\n\t<div id=\"divMensajesProv\">\r\n   \t\r\n   \t\r\n   \t</div>\r\n   \t<div><p class=\"mf-paragraph-header\"><strong>ATENCI&Oacute;N, LEA ATENTAMENTE ANTES DE ACEPTAR UNA CITA:</strong></p>\r\n<ul>\r\n<li class=\"mf-pager\">Si usted es Residente temporal o tiene una estancia por estudios, y tiene certificado digital <strong>se recomienda el uso de la plataforma <a title=\"Abre ventana nueva\" href=\"https://sede.administracionespublicas.gob.es/mercurio/inicioMercurio.html\" target=\"_blank\">MERCURIO</a></strong> para renovar.</li>\r\n<li class=\"mf-pager\">Si usted quiere realizar una Solicitud Inicial, y tiene certificado digital <strong>se recomienda el uso de la plataforma <a title=\"Abre ventana nueva\" href=\"https://sede.administracionespublicas.gob.es/mercurio/inicioMercurio.html\" target=\"_blank\">MERCURIO</a> </strong></li>\r\n</ul>\r\n<ul>\r\n<li class=\"mf-pager\">Puede descargar el <a title=\"Abre ventana nueva\" href=\"https://www.inclusion.gob.es/web/migraciones/informacion-util/modelos-de-solicitud\" target=\"_blank\">Modelo oficial de solicitud</a>.</li>\r\n<li class=\"mf-pager\">Puede descargar la <a title=\"Abre ventana nueva\" href=\"https://www.inclusion.gob.es/web/migraciones/hojas-informativas\" target=\"_blank\">Informaci&oacute;n sobre tr&aacute;mites y procedimientos - Hojas Informativas</a>.</li>\r\n<li class=\"mf-pager\">Puede descargar la <a title=\"Abre ventana nueva\" href=\"https://sede.administracionespublicas.gob.es/procedimientos/index/categoria/33\" target=\"_blank\">tasa</a>.</li>\r\n<li class=\"mf-pager\">Si lo que desea es informaci&oacute;n general, recuerde que la tiene a su disposici&oacute;n en el enlace anterior. Tambi&eacute;n puede recibir informaci&oacute;n accediendo directamente a consultas en la Oficina de Extranjeros correspondiente a su lugar de residencia, en el siguiente enlace podr&aacute; acceder a sus tel&eacute;fonos y correos electr&oacute;nicos: <a title=\"Abre ventana nueva\" href=\"https://www.mptfp.gob.es/portal/delegaciones_gobierno/extranjeria/extranjeria_ddgg.htm\" target=\"_blank\">Informaci&oacute;n Oficinas Extranjer&iacute;a</a>.</li>\r\n<li class=\"mf-pager\">Si desea obtener el certificado digital, puede hacerlo en <a title=\"Abre ventana nueva\" href=\"http://www.fnmt.es/ceres\" target=\"_blank\">FNMT-RCM</a>.</li>\r\n</ul></div>\r\n   \t<div>\r\n   \t\t<div class=\"mf-note\">\r\n   \t\t\t<strong></strong> <span><p><strong>IMPORTANTE</strong>: Para el tr&aacute;mite de <strong>POLICIA-SOLICITUD DE ASILO</strong>, si la provincia seleccionada no ofrece citas para este tr&aacute;mite, p&oacute;ngase en contacto con la oficina correspondiente.</p></span>\r\n   \t\t</div>\r\n   \t\t<br/>\r\n   \t</div>\t\t\t\r\n\t<div> \r\n                                                    \r\n    </div> \r\n\t\r\n\t</form>\r\n\t<form name=\"ayudaRequisitos\" id=\"ayudaRequisitos\" method=\"post\" action=\"/icpplus/ayudaRequisitos\" target=\"_blank\"><input type=\"hidden\" name=\"d72b307a-c9b1-4c5f-84a0-be64dbb119e9\" value=\"a17e82fd-e4a9-4d74-954c-6e7a77685196\"/><input type=\"hidden\" name=\"393297d5-104d-4ba3-ab22-81ad8d047363\" value/>\r\n\t\t<input type=\"hidden\" name=\"method\" value=\"ayudaRequisitos\"/>\r\n\t</form>\r\n<script>\r\n\tvar org = \"AGE\"\r\n\tif(document.getElementById(\"tramiteGrupo[0]\")!=null){\r\n\t\tdocument.getElementById(\"tramiteGrupo[0]\").focus();\t\r\n\t}\r\n\t\r\n\t$('document').ready(function(){\r\n\t\tif($(\"#provincia\").length!=0){\r\n\t\t\t//cargaMensajesProv();\r\n\t\t}\r\n\t\t$('select option[value=\"-1\"]').attr(\"selected\",true);\r\n\t\t window.scrollTo(0, 0);\r\n\t});\r\n</script>\r\n<script src=\"/icpplus/resources/js/icp/portada_pt.min.js?v=V%207.50.2\">\r\n</script>\r\n</div>\r\n</section>\r\n</div>\r\n</div>\r\n</main>\r\n\t</div>\r\n\t</div>\r\n\t<footer id=\"footerNew\" class=\"mf-footer noprint\"><div class=\"mf-footer--container\">   \t  \n      <ul id=\"footermenu\" class=\"mf-footer--menu\">\n            <li class=\"mf-footer--menu-item\"><a href=\"accesibilidad\" target=\"_blank\">Accesibilidad</a></li>\n            <li class=\"mf-footer--menu-item\"><a href=\"avisolegal\" target=\"_blank\">Aviso legal</a></li>\n            <li class=\"mf-footer--menu-item\"><a href=\"contacto\" target=\"_blank\">Contacto</a></li>\n    </ul><p id=\"copyright\" class=\"mf-footer--copy\">&co